/* MeloTools SaaS theme override
   Loaded after the XP skin and activated with html[data-ui-theme="saas"]. */

html[data-ui-theme="saas"],
html[data-ui-theme="saas"] body{
  color-scheme:light;
  background:
    radial-gradient(circle at 18% 12%, rgba(96,165,250,.20) 0, rgba(96,165,250,0) 34%),
    radial-gradient(circle at 82% 4%, rgba(34,197,94,.12) 0, rgba(34,197,94,0) 26%),
    linear-gradient(180deg,#f8fbff 0%,#eef5ff 44%,#f8fafc 100%) !important;
  color:#0f172a !important;
  font-family:Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif !important;
  font-size:14px !important;
  cursor:auto !important;
  -webkit-font-smoothing:antialiased !important;
}

html[data-ui-theme="saas"] body::before,
html[data-ui-theme="saas"] body::after,
html[data-ui-theme="saas"] .card::before,
html[data-ui-theme="saas"] .card::after{
  content:none !important;
  display:none !important;
}

html[data-ui-theme="saas"] button,
html[data-ui-theme="saas"] input,
html[data-ui-theme="saas"] select,
html[data-ui-theme="saas"] textarea{
  font-family:Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif !important;
  font-size:14px !important;
  cursor:auto;
}
html[data-ui-theme="saas"] button,
html[data-ui-theme="saas"] .btn,
html[data-ui-theme="saas"] .tabbtn,
html[data-ui-theme="saas"] .lang-current,
html[data-ui-theme="saas"] .lang-option,
html[data-ui-theme="saas"] .theme-option,
html[data-ui-theme="saas"] a.btn{ cursor:pointer !important; }

html[data-ui-theme="saas"] .header{
  padding:18px 20px 8px !important;
  align-items:center !important;
  text-align:center !important;
}
html[data-ui-theme="saas"] .header-top{
  width:min(1180px,100%) !important;
  justify-content:flex-end !important;
  gap:10px !important;
  margin:0 auto 8px !important;
}
html[data-ui-theme="saas"] .wrap{
  max-width:1180px !important;
  padding:0 18px 36px !important;
  margin:0 auto !important;
}

html[data-ui-theme="saas"] .theme-switcher{
  display:inline-flex !important;
  align-items:center !important;
  gap:4px !important;
  padding:4px !important;
  border:1px solid rgba(148,163,184,.34) !important;
  border-radius:999px !important;
  background:rgba(255,255,255,.76) !important;
  box-shadow:0 14px 36px rgba(15,23,42,.08) !important;
  backdrop-filter:blur(16px) !important;
}
html[data-ui-theme="saas"] .theme-option{
  min-height:34px !important;
  padding:0 13px !important;
  border:0 !important;
  border-radius:999px !important;
  background:transparent !important;
  color:#475569 !important;
  font-weight:750 !important;
  line-height:1 !important;
  box-shadow:none !important;
  text-shadow:none !important;
}
html[data-ui-theme="saas"] .theme-option.active{
  color:#fff !important;
  background:linear-gradient(135deg,#2563eb,#0f63d8) !important;
  box-shadow:0 8px 18px rgba(37,99,235,.28) !important;
}

html[data-ui-theme="saas"] .lang-current{
  width:46px !important;
  height:46px !important;
  border:1px solid rgba(148,163,184,.28) !important;
  border-radius:16px !important;
  background:rgba(255,255,255,.82) !important;
  box-shadow:0 14px 30px rgba(15,23,42,.08) !important;
}
html[data-ui-theme="saas"] .lang-menu{
  right:0 !important;
  left:auto !important;
  padding:10px !important;
  gap:8px !important;
  border:1px solid rgba(148,163,184,.26) !important;
  border-radius:20px !important;
  background:rgba(255,255,255,.96) !important;
  box-shadow:0 24px 48px rgba(15,23,42,.14) !important;
  backdrop-filter:blur(16px) !important;
}
html[data-ui-theme="saas"] .lang-option{
  width:46px !important;
  height:46px !important;
  border:0 !important;
  border-radius:14px !important;
  background:transparent !important;
}
html[data-ui-theme="saas"] .lang-option:hover,
html[data-ui-theme="saas"] .lang-option.active{
  background:#eff6ff !important;
}

html[data-ui-theme="saas"] .xp-window-titlebar,
html[data-ui-theme="saas"] .xp-mute-btn{
  display:none !important;
}

html[data-ui-theme="saas"] .card{
  overflow:visible !important;
  padding:28px !important;
  border:1px solid rgba(148,163,184,.26) !important;
  border-radius:30px !important;
  background:rgba(255,255,255,.86) !important;
  box-shadow:0 24px 70px rgba(15,23,42,.10) !important;
  backdrop-filter:blur(20px) !important;
}
html[data-ui-theme="saas"] .logo-wrap{
  justify-content:center !important;
  margin:2px auto 20px !important;
  text-align:center !important;
}
html[data-ui-theme="saas"] .logo,
html[data-ui-theme="saas"] .logo:hover,
html[data-ui-theme="saas"] .logo:focus{
  width:min(440px,82vw) !important;
  filter:none !important;
  box-shadow:none !important;
  transform:none !important;
}

html[data-ui-theme="saas"] .nav-shell{
  padding:10px !important;
  margin:0 auto 26px !important;
  border:1px solid rgba(148,163,184,.22) !important;
  border-radius:24px !important;
  background:linear-gradient(180deg,rgba(255,255,255,.94),rgba(248,250,252,.86)) !important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.8), 0 12px 30px rgba(15,23,42,.06) !important;
}
html[data-ui-theme="saas"] .main-tabs,
html[data-ui-theme="saas"] .tool-tabs{
  display:flex !important;
  flex-wrap:wrap !important;
  justify-content:center !important;
  gap:8px !important;
  padding:0 !important;
  margin:0 !important;
  border:0 !important;
  background:transparent !important;
}
html[data-ui-theme="saas"] .tool-tabs{
  margin-top:10px !important;
  padding-top:10px !important;
  border-top:1px solid rgba(148,163,184,.18) !important;
}
html[data-ui-theme="saas"] .main-tab,
html[data-ui-theme="saas"] .tool-tab,
html[data-ui-theme="saas"] .tabbtn{
  min-height:40px !important;
  padding:10px 15px !important;
  border:1px solid rgba(148,163,184,.24) !important;
  border-radius:999px !important;
  color:#334155 !important;
  background:#fff !important;
  box-shadow:0 7px 18px rgba(15,23,42,.06) !important;
  font-weight:750 !important;
  line-height:1.1 !important;
  text-shadow:none !important;
}
html[data-ui-theme="saas"] .main-tab:hover,
html[data-ui-theme="saas"] .tool-tab:hover,
html[data-ui-theme="saas"] .tabbtn:hover{
  border-color:rgba(37,99,235,.35) !important;
  color:#1d4ed8 !important;
  transform:translateY(-1px) !important;
}
html[data-ui-theme="saas"] .main-tab.active,
html[data-ui-theme="saas"] .tool-tab.active,
html[data-ui-theme="saas"] .tabbtn.active{
  color:#fff !important;
  border-color:transparent !important;
  background:linear-gradient(135deg,#2563eb,#0f63d8) !important;
  box-shadow:0 12px 26px rgba(37,99,235,.28) !important;
}

html[data-ui-theme="saas"] .section{
  text-align:center !important;
}
html[data-ui-theme="saas"] .title{
  margin:0 0 8px !important;
  color:#0f172a !important;
  font-size:clamp(24px,3vw,36px) !important;
  line-height:1.08 !important;
  letter-spacing:-.04em !important;
  text-align:center !important;
  font-weight:850 !important;
  text-shadow:none !important;
}
html[data-ui-theme="saas"] .sub{
  max-width:760px !important;
  margin:0 auto 22px !important;
  color:#64748b !important;
  font-size:15px !important;
  line-height:1.55 !important;
  text-align:center !important;
}
html[data-ui-theme="saas"] .note,
html[data-ui-theme="saas"] .small{
  color:#64748b !important;
  font-size:13px !important;
  line-height:1.45 !important;
}

html[data-ui-theme="saas"] .youtube-panel,
html[data-ui-theme="saas"] .media-download-card,
html[data-ui-theme="saas"] .instagram-card,
html[data-ui-theme="saas"] .drop,
html[data-ui-theme="saas"] .removebg-strength,
html[data-ui-theme="saas"] .removebg-preview-card,
html[data-ui-theme="saas"] .media-options-panel,
html[data-ui-theme="saas"] .youtube-options,
html[data-ui-theme="saas"] .cookie-notice,
html[data-ui-theme="saas"] .cookie-panel-card,
html[data-ui-theme="saas"] .cookie-footer-link,
html[data-ui-theme="saas"] .window{
  border:1px solid rgba(148,163,184,.24) !important;
  border-radius:24px !important;
  background:rgba(255,255,255,.88) !important;
  box-shadow:0 16px 44px rgba(15,23,42,.08) !important;
  backdrop-filter:blur(18px) !important;
}
html[data-ui-theme="saas"] .media-tool-shell,
html[data-ui-theme="saas"] .media-tool-shell-narrow{
  max-width:920px !important;
  margin:0 auto !important;
}
html[data-ui-theme="saas"] .youtube-panel,
html[data-ui-theme="saas"] .media-download-card,
html[data-ui-theme="saas"] .instagram-card{
  padding:22px !important;
}
html[data-ui-theme="saas"] .media-tool-title{
  color:#0f172a !important;
  font-size:18px !important;
  font-weight:850 !important;
  text-align:left !important;
}
html[data-ui-theme="saas"] .drop{
  max-width:920px !important;
  margin:0 auto !important;
  padding:28px !important;
  border:1.5px dashed rgba(37,99,235,.32) !important;
  background:linear-gradient(180deg,rgba(239,246,255,.82),rgba(255,255,255,.88)) !important;
}
html[data-ui-theme="saas"] .drop.dragover{
  border-color:#2563eb !important;
  box-shadow:0 0 0 4px rgba(37,99,235,.12), 0 18px 46px rgba(37,99,235,.14) !important;
}
html[data-ui-theme="saas"] .icon{
  color:#2563eb !important;
  filter:drop-shadow(0 8px 14px rgba(37,99,235,.18)) !important;
}

html[data-ui-theme="saas"] input,
html[data-ui-theme="saas"] select,
html[data-ui-theme="saas"] textarea{
  min-height:44px !important;
  border:1px solid #cbd5e1 !important;
  border-radius:16px !important;
  background:#fff !important;
  color:#0f172a !important;
  box-shadow:0 1px 0 rgba(255,255,255,.75), inset 0 1px 2px rgba(15,23,42,.04) !important;
  outline:none !important;
}
html[data-ui-theme="saas"] textarea{
  min-height:128px !important;
  padding:14px 16px !important;
}
html[data-ui-theme="saas"] input:focus,
html[data-ui-theme="saas"] select:focus,
html[data-ui-theme="saas"] textarea:focus{
  border-color:#2563eb !important;
  box-shadow:0 0 0 4px rgba(37,99,235,.13) !important;
}
html[data-ui-theme="saas"] .clip-url-input,
html[data-ui-theme="saas"] .social-url-input{
  max-width:100% !important;
  width:100% !important;
}

html[data-ui-theme="saas"] .btn,
html[data-ui-theme="saas"] button.btn,
html[data-ui-theme="saas"] a.btn{
  min-height:42px !important;
  padding:10px 17px !important;
  border:0 !important;
  border-radius:15px !important;
  color:#fff !important;
  background:linear-gradient(135deg,#2563eb,#0f63d8) !important;
  box-shadow:0 12px 24px rgba(37,99,235,.26) !important;
  font-weight:800 !important;
  text-align:center !important;
  text-shadow:none !important;
}
html[data-ui-theme="saas"] .btn:hover,
html[data-ui-theme="saas"] button.btn:hover,
html[data-ui-theme="saas"] a.btn:hover{
  transform:translateY(-1px) !important;
  box-shadow:0 16px 28px rgba(37,99,235,.32) !important;
}
html[data-ui-theme="saas"] .btn:active,
html[data-ui-theme="saas"] button.btn:active,
html[data-ui-theme="saas"] a.btn:active{
  transform:translateY(0) scale(.99) !important;
}
html[data-ui-theme="saas"] .btn.alt,
html[data-ui-theme="saas"] .btn.secondary{
  color:#1e293b !important;
  background:#eef4ff !important;
  box-shadow:none !important;
  border:1px solid rgba(148,163,184,.22) !important;
}

html[data-ui-theme="saas"] .inputs,
html[data-ui-theme="saas"] .media-action-strip,
html[data-ui-theme="saas"] .media-command-row,
html[data-ui-theme="saas"] .clip-control-grid{
  gap:10px !important;
  text-align:left !important;
}
html[data-ui-theme="saas"] .row,
html[data-ui-theme="saas"] .item,
html[data-ui-theme="saas"] .youtube-meta,
html[data-ui-theme="saas"] .youtube-batch-item{
  border:1px solid rgba(148,163,184,.22) !important;
  border-radius:18px !important;
  background:#fff !important;
  box-shadow:0 10px 28px rgba(15,23,42,.06) !important;
}
html[data-ui-theme="saas"] .progress,
html[data-ui-theme="saas"] .youtube-progress-bar{
  border:0 !important;
  border-radius:999px !important;
  background:#e2e8f0 !important;
  overflow:hidden !important;
}
html[data-ui-theme="saas"] .progress > div,
html[data-ui-theme="saas"] .youtube-progress-bar > div{
  border-radius:999px !important;
  background:linear-gradient(90deg,#2563eb,#22c55e) !important;
}

html[data-ui-theme="saas"] .footer{
  margin-top:24px !important;
  padding:16px !important;
  border:1px solid rgba(148,163,184,.22) !important;
  border-radius:20px !important;
  background:rgba(255,255,255,.72) !important;
  color:#64748b !important;
  text-align:center !important;
  box-shadow:0 12px 32px rgba(15,23,42,.06) !important;
}
html[data-ui-theme="saas"] .footer a,
html[data-ui-theme="saas"] .footer-link,
html[data-ui-theme="saas"] .cookie-policy-link,
html[data-ui-theme="saas"] .cookie-footer-link{
  color:#2563eb !important;
}

html[data-ui-theme="saas"] .xp-dialog{
  border:1px solid rgba(148,163,184,.28) !important;
  border-radius:22px !important;
  background:#fff !important;
  box-shadow:0 30px 90px rgba(15,23,42,.22) !important;
  overflow:hidden !important;
}
html[data-ui-theme="saas"] .xp-dialog-titlebar{
  background:linear-gradient(135deg,#2563eb,#0f63d8) !important;
  border:0 !important;
}

/* Cookie policy page */
html[data-ui-theme="saas"] .policy-themebar{
  display:flex !important;
  justify-content:flex-end !important;
  margin-bottom:12px !important;
}
html[data-ui-theme="saas"] .back{
  border:1px solid rgba(148,163,184,.25) !important;
  border-radius:999px !important;
  color:#2563eb !important;
  background:#fff !important;
  box-shadow:0 10px 24px rgba(15,23,42,.07) !important;
}
html[data-ui-theme="saas"] .window-title{
  color:#0f172a !important;
  background:transparent !important;
  border:0 !important;
  padding:24px 24px 6px !important;
  font-size:30px !important;
  letter-spacing:-.04em !important;
  text-shadow:none !important;
}
html[data-ui-theme="saas"] .window-body{ padding:12px 24px 24px !important; }
html[data-ui-theme="saas"] .badge{
  border:0 !important;
  border-radius:999px !important;
  color:#1d4ed8 !important;
  background:#eff6ff !important;
}
html[data-ui-theme="saas"] h2{ color:#0f172a !important; font-size:20px !important; }
html[data-ui-theme="saas"] p,
html[data-ui-theme="saas"] li{ color:#475569 !important; }
html[data-ui-theme="saas"] .table{
  border-collapse:separate !important;
  border-spacing:0 !important;
  overflow:hidden !important;
  border-radius:18px !important;
  box-shadow:0 12px 28px rgba(15,23,42,.06) !important;
}
html[data-ui-theme="saas"] .table th,
html[data-ui-theme="saas"] .table td{
  border-color:#e2e8f0 !important;
}
html[data-ui-theme="saas"] .table th{
  color:#0f172a !important;
  background:#f8fafc !important;
}

@media (max-width:760px){
  html[data-ui-theme="saas"] .header{ padding:12px 10px 4px !important; }
  html[data-ui-theme="saas"] .header-top{ justify-content:center !important; flex-wrap:wrap !important; }
  html[data-ui-theme="saas"] .wrap{ padding:0 10px 26px !important; }
  html[data-ui-theme="saas"] .card{ padding:16px 12px !important; border-radius:24px !important; }
  html[data-ui-theme="saas"] .nav-shell{ border-radius:20px !important; padding:8px !important; }
  html[data-ui-theme="saas"] .main-tab,
  html[data-ui-theme="saas"] .tool-tab,
  html[data-ui-theme="saas"] .tabbtn{ width:auto !important; flex:1 1 140px !important; min-height:42px !important; }
  html[data-ui-theme="saas"] .title{ font-size:25px !important; }
  html[data-ui-theme="saas"] .youtube-panel,
  html[data-ui-theme="saas"] .media-download-card,
  html[data-ui-theme="saas"] .instagram-card,
  html[data-ui-theme="saas"] .drop{ padding:16px !important; border-radius:20px !important; }
  html[data-ui-theme="saas"] .btn,
  html[data-ui-theme="saas"] button.btn,
  html[data-ui-theme="saas"] a.btn{ width:100%; }
  html[data-ui-theme="saas"] .theme-switcher{ order:3; width:100%; justify-content:center !important; }
  html[data-ui-theme="saas"] .theme-option{ flex:1; }
}
