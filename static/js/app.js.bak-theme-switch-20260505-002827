/* Navigation */
const NAV_CATEGORY_KEY = 'melotools-active-category';
const NAV_TOOL_KEY = 'melotools-active-tool';
const mainTabs = Array.from(document.querySelectorAll('.main-tab'));
const toolTabs = Array.from(document.querySelectorAll('.tool-tab'));
const sections = Array.from(document.querySelectorAll('.section'));

function centerNavButton(button){
  if(!button || typeof button.scrollIntoView !== 'function') return;
  button.scrollIntoView({ behavior:'smooth', block:'nearest', inline:'center' });
}

function getVisibleToolTabs(category){
  return toolTabs.filter((tab)=>tab.dataset.category === category);
}

function activateTool(tabId, options = {}){
  const { save = true, center = true } = options;
  const target = toolTabs.find((tab)=>tab.dataset.tab === tabId);
  if(!target) return;

  const category = target.dataset.category;
  toolTabs.forEach((tab)=>{
    tab.classList.toggle('active', tab === target);
  });

  sections.forEach((section)=>{
    const shouldShow = section.id === tabId && section.dataset.category === category;
    section.classList.toggle('show', shouldShow);
  });

  if(save){
    localStorage.setItem(NAV_TOOL_KEY, tabId);
  }

  if(center){
    centerNavButton(target);
  }
}

function activateCategory(category, options = {}){
  const { save = true, preferredTool = null } = options;
  const visibleTools = getVisibleToolTabs(category);
  if(!visibleTools.length) return;

  mainTabs.forEach((tab)=>{
    tab.classList.toggle('active', tab.dataset.category === category);
  });

  toolTabs.forEach((tab)=>{
    const belongs = tab.dataset.category === category;
    tab.classList.toggle('is-hidden', !belongs);
  });

  const savedToolId = preferredTool || localStorage.getItem(NAV_TOOL_KEY);
  const nextTool = visibleTools.find((tab)=>tab.dataset.tab === savedToolId) || visibleTools[0];

  if(save){
    localStorage.setItem(NAV_CATEGORY_KEY, category);
  }

  activateTool(nextTool.dataset.tab, { save, center:false });
  const activeMainTab = mainTabs.find((tab)=>tab.dataset.category === category);
  centerNavButton(activeMainTab);
  centerNavButton(nextTool);
}

mainTabs.forEach((tab)=>{
  tab.addEventListener('click', ()=>{
    activateCategory(tab.dataset.category);
  });
});

toolTabs.forEach((tab)=>{
  tab.addEventListener('click', ()=>{
    activateCategory(tab.dataset.category, { save:true, preferredTool:tab.dataset.tab });
  });
});

const initialCategory = localStorage.getItem(NAV_CATEGORY_KEY) || 'media';
activateCategory(initialCategory, { save:false });


