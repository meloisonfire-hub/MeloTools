}

function escapeHtml(value){
  return String(value ?? '').replace(/[&<>"']/g, (ch)=>({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch] || ch));
}

function parseMediaLinks(raw){
  return String(raw || '').split(/\s+/).map((part)=>part.trim()).filter(Boolean);
}

function looksLikeSupportedVideoUrl(url){
  const value = String(url || '').trim().toLowerCase();
  if(!/^https?:\/\//.test(value)) return false;
  return [
    'youtube.com/', 'youtu.be/', 'vimeo.com/', 'tiktok.com/', 'vm.tiktok.com/', 'vt.tiktok.com/',
    'instagram.com/reel/', 'instagram.com/p/', 'instagram.com/tv/', '.tv.pandavideo.com.br/embed/', '.tv.pandavideo.com.br/videos/'
  ].some((part)=>value.includes(part));
}

