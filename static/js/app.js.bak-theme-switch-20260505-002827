const youtubeClipUrl = document.getElementById('youtubeClipUrl');
const youtubeClipErr = document.getElementById('youtubeClipErr');
const youtubeClipMeta = document.getElementById('youtubeClipMeta');
const youtubeClipQuality = document.getElementById('youtubeClipQuality');
const youtubeClipQualityControls = document.querySelectorAll('.clip-quality-control');
const youtubeClipStart = document.getElementById('youtubeClipStart');
const youtubeClipEnd = document.getElementById('youtubeClipEnd');
const runYoutubeClip = document.getElementById('runYoutubeClip');
const youtubeClipStatus = document.getElementById('youtubeClipStatus');
const youtubeClipProgressRow = document.getElementById('youtubeClipProgressRow');
const youtubeClipProgressText = document.getElementById('youtubeClipProgressText');
const youtubeClipResult = document.getElementById('youtubeClipResult');
let youtubeClipJobPoll = null;

function stopYoutubeClipPolling(){ if(youtubeClipJobPoll){ clearInterval(youtubeClipJobPoll); youtubeClipJobPoll = null; } }
function setYoutubeClipQualityVisible(visible){
  youtubeClipQualityControls.forEach((el)=>el.classList.toggle('hidden', !visible));
  if(youtubeClipQuality){ youtubeClipQuality.disabled = !visible; }
}
function setYoutubeClipProgress(pct, text){
  const row = youtubeClipProgressRow;
  const bar = row.querySelector('.progress > div');
  row.classList.remove('hidden');
  bar.style.width = `${Math.max(0, Math.min(100, Number(pct)||0))}%`;
  youtubeClipProgressText.textContent = text || 'Processando...';
}

async function analyzeYoutubeClipUrl(){
  const url = (youtubeClipUrl?.value || '').trim();
  if(!url){ youtubeClipMeta.classList.add('hidden'); youtubeClipMeta.innerHTML=''; setYoutubeClipQualityVisible(false); return false; }
  const fd = new FormData(); fd.append('url', url);
  setYoutubeClipQualityVisible(false);
  youtubeClipStatus.textContent = 'Analisando link...';
  try{
    const { data: js } = await fetchJsonSafe('/youtube/info',{ method:'POST', body:fd });
    if(!js.ok){ showErr(youtubeClipErr, extractMessage(js)); youtubeClipStatus.textContent=''; setYoutubeClipQualityVisible(false); return false; }
    hideErr(youtubeClipErr);
    youtubeClipQuality.innerHTML='';
    (js.info.qualities||[{value:'720',label:'720p'}]).forEach((q)=>{ const o=document.createElement('option'); o.value=q.value; o.textContent=q.label; youtubeClipQuality.appendChild(o); });
    youtubeClipMeta.classList.remove('hidden');
    youtubeClipMeta.innerHTML = `<img class="youtube-meta-thumb" src="${js.info.thumbnail||''}" alt=""><div class="youtube-meta-copy"><strong>${escapeHtml(js.info.title||'V?deo')}</strong><span>${t('duration', { value: fmtDuration(js.info.duration) })}</span></div>`;
    youtubeClipStatus.textContent = 'Link pronto.';
    setYoutubeClipQualityVisible(true);
    return true;
  }catch(e){ showErr(youtubeClipErr, t('error_prefix', { error: e })); youtubeClipStatus.textContent=''; setYoutubeClipQualityVisible(false); return false; }
}

async function pollYoutubeClipJob(jobId){
  const { data: js } = await fetchJsonSafe(`/youtube/progress/${encodeURIComponent(jobId)}`, { method:'GET' });
  if(!js.ok || !js.job){ throw new Error('Falha ao consultar progresso'); }
  const job = js.job;
  setYoutubeClipProgress(job.progress || 0, extractMessage(job, 'processing_generic'));
  if(job.status === 'done'){
    stopYoutubeClipPolling(); youtubeClipProgressRow.classList.add('hidden');
    const outName = (job.result && job.result.out_name) || 'arquivo.mp4';
    youtubeClipResult.classList.remove('hidden');
    youtubeClipResult.innerHTML = `<a class="btn" href="/results/${encodeURIComponent(outName)}" download="${escapeHtml(outName)}">${t('download')}</a>`;
    triggerAutoDownload(outName);
    youtubeClipStatus.textContent='';
    return true;
  }
  if(job.status === 'error'){
    stopYoutubeClipPolling(); youtubeClipProgressRow.classList.add('hidden');
    showErr(youtubeClipErr, extractMessage(job)); youtubeClipStatus.textContent='';
    return true;
  }
  return false;
}

if(youtubeClipUrl){
  let clipAnalyzeTimer = null;
  const queueClipAnalyze = ()=>{
    setYoutubeClipQualityVisible(false);
    if(clipAnalyzeTimer) clearTimeout(clipAnalyzeTimer);
    clipAnalyzeTimer = setTimeout(analyzeYoutubeClipUrl, 220);
  };
  youtubeClipUrl.addEventListener('input', queueClipAnalyze);
  youtubeClipUrl.addEventListener('paste', ()=>{ setTimeout(queueClipAnalyze, 30); });
  youtubeClipUrl.addEventListener('change', queueClipAnalyze);
  youtubeClipUrl.addEventListener('blur', queueClipAnalyze);
  runYoutubeClip.addEventListener('click', async ()=>{
    const url = (youtubeClipUrl.value || '').trim();
    const start = (youtubeClipStart.value || '').trim();
    const end = (youtubeClipEnd.value || '').trim();
    if(!url){ showErr(youtubeClipErr, 'Cole o link do v?deo.'); return; }
    if(!start || !end){ showErr(youtubeClipErr, 'Preencha in?cio e fim.'); return; }
    const s = parseClipInputToSeconds(start); const e = parseClipInputToSeconds(end);
    if(Number.isNaN(s) || Number.isNaN(e)){ showErr(youtubeClipErr, 'Formato inv?lido. Use mm:ss ou hh:mm:ss.'); return; }
    if(e <= s){ showErr(youtubeClipErr, 'O tempo final precisa ser maior que o inicial.'); return; }

    hideErr(youtubeClipErr); stopYoutubeClipPolling(); youtubeClipResult.classList.add('hidden');
    const analyzed = await analyzeYoutubeClipUrl();
    if(!analyzed){ return; }
    youtubeClipStatus.textContent='Iniciando clipe...'; setYoutubeClipProgress(2, 'Preparando clipe...');

    const fd = new FormData();
    fd.append('url', url); fd.append('mode', 'video');
    fd.append('quality', youtubeClipQuality.value || '720');
    fd.append('bitrate', '192');
    fd.append('clip_start', start); fd.append('clip_end', end);

    try{
      const { data: js } = await fetchJsonSafe('/youtube/download',{ method:'POST', body:fd });
      if(!js.ok){ showErr(youtubeClipErr, extractMessage(js)); youtubeClipStatus.textContent=''; youtubeClipProgressRow.classList.add('hidden'); return; }
      const done = await pollYoutubeClipJob(js.job_id); if(done) return;
      youtubeClipJobPoll = setInterval(async ()=>{ try{ const fin=await pollYoutubeClipJob(js.job_id); if(fin) stopYoutubeClipPolling(); }catch(err){ stopYoutubeClipPolling(); youtubeClipProgressRow.classList.add('hidden'); showErr(youtubeClipErr, String(err)); } }, 2000);
    }catch(e){ showErr(youtubeClipErr, t('error_prefix', { error: e })); youtubeClipStatus.textContent=''; youtubeClipProgressRow.classList.add('hidden'); }
  });
}



