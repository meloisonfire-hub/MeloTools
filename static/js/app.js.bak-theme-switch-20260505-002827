const mergeResult=document.getElementById('mergeResult');

let mergeFiles=[];
let pdfjsLibPromise = null;

async function getPdfjsLib(){
  if(pdfjsLibPromise) return pdfjsLibPromise;
  pdfjsLibPromise = import('/static/vendor/pdfjs/pdf.min.mjs')
    .then(mod=>{
      const lib = mod && (mod.default || mod);
      if(lib && lib.GlobalWorkerOptions){
        lib.GlobalWorkerOptions.workerSrc = '/static/vendor/pdfjs/pdf.worker.min.mjs';
      }
      return lib;
    })
    .catch(()=>null);
  return pdfjsLibPromise;
}

async function renderMergePdfThumb(file, canvas){
  if(!canvas) return;
  const pdfjsLib = await getPdfjsLib();
  if(!pdfjsLib) return;
  const url = URL.createObjectURL(file);
  try{
    const pdf = await pdfjsLib.getDocument(url).promise;
    const page = await pdf.getPage(1);
    const viewport = page.getViewport({ scale: 1 });
    const scale = Math.min(64 / viewport.width, 88 / viewport.height);
    const scaled = page.getViewport({ scale });
    const ctx = canvas.getContext('2d');
    canvas.width = Math.max(1, Math.floor(scaled.width));
    canvas.height = Math.max(1, Math.floor(scaled.height));
    await page.render({ canvasContext: ctx, viewport: scaled }).promise;
  }catch(_e){
    const ctx = canvas.getContext('2d');
    canvas.width = 64;
    canvas.height = 88;
    ctx.fillStyle = '#f8fafc';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = '#475569';
    ctx.font = 'bold 12px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(t('pdf_label'), canvas.width / 2, canvas.height / 2);
  }finally{
    URL.revokeObjectURL(url);
  }
}

function renderMergeList(){
  mergeList.innerHTML='';
  mergeFiles.forEach((it,idx)=>{
    const isImg=/\.(jpg|jpeg|png|tif|tiff)$/i.test(it.file.name);
    const isPdf=/\.pdf$/i.test(it.file.name);
    const url=isImg?URL.createObjectURL(it.file):'';
    const thumb=isImg
      ? `<span class="thumb"><img src="${url}"></span>`
      : isPdf
        ? `<span class="thumb"><canvas class="pdfthumb-canvas" data-id="${it.id}"></canvas></span>`
        : `<span class="thumb"><svg class="pdficon" viewBox="0 0 24 24" fill="currentColor"><path d="M6 2h7l5 5v15H6zM13 3.5V8h4.5"/></svg>${t('pdf_label')}</span>`;
    const el=document.createElement('div');
    el.className='item';
    el.draggable=true;
    el.dataset.id=it.id;
    el.innerHTML = `
      ${thumb}
      <div class="iname" title="${it.file.name}">${idx+1}. ${it.file.name}</div>
      <div class="controls">
        <button class="btn alt rm" data-id="${it.id}">remover</button>
      </div>
    `;
    mergeList.appendChild(el);
  });

  mergeList.querySelectorAll('.pdfthumb-canvas').forEach(canvas=>{
    const item = mergeFiles.find(x=>x.id===canvas.dataset.id);
    if(item){ renderMergePdfThumb(item.file, canvas); }
  });

  mergeList.querySelectorAll('.rm').forEach(b=>b.addEventListener('click',()=>{
    const id=b.dataset.id;
    mergeFiles=mergeFiles.filter(x=>x.id!==id);
    renderMergeList();
  }));

  mergeList.querySelectorAll('.item').forEach(el=>{
    el.addEventListener('dragstart', e=>{
      e.dataTransfer.setData('text/plain', el.dataset.id);
      e.dataTransfer.effectAllowed='move';
    });
    el.addEventListener('dragover', e=>{
      e.preventDefault();
      e.dataTransfer.dropEffect='move';
    });
    el.addEventListener('drop', e=>{
      e.preventDefault();
      const fromId=e.dataTransfer.getData('text/plain');
      const toId=el.dataset.id;
      if(!fromId||fromId===toId) return;
      const from=mergeFiles.findIndex(x=>x.id===fromId);
      const to=mergeFiles.findIndex(x=>x.id===toId);
      const [m]=mergeFiles.splice(from,1);
      mergeFiles.splice(to,0,m);
      renderMergeList();
    });
  });
}

function addMergeFiles(fs){
  let ok=0;
  for(const f of fs){
    if(!extOk(f.name)){ showErr(mergeErr,t('unsupported_pdf_image')); continue; }
    if(!sizeOk(f)){ showErr(mergeErr,t('file_limit', { max_mb: MAX_MB })); continue; }
    hideErr(mergeErr);
    mergeFiles.push({file:f,id:Math.random().toString(36).slice(2,9)});
    ok++;
  }
  if(ok>0) renderMergeList();
}

['dragenter','dragover'].forEach(ev=>dropMerge.addEventListener(ev,e=>{
  e.preventDefault();
  dropMerge.classList.add('dragover');
}));

['dragleave','drop'].forEach(ev=>dropMerge.addEventListener(ev,e=>{
  e.preventDefault();
  dropMerge.classList.remove('dragover');
}));

dropMerge.addEventListener('drop', e=>{
  const fs=e.dataTransfer.files;
  if(fs&&fs.length){ addMergeFiles(fs); }
});

chooseMerge.addEventListener('click', ()=>filesMerge.click());
filesMerge.addEventListener('change', ()=>{
  if(filesMerge.files.length){
    addMergeFiles(filesMerge.files);
    filesMerge.value='';
  }
});

runMerge.addEventListener('click', async ()=>{
  if(mergeFiles.length===0){ mergeStatus.textContent=t('select_files_first'); return; }
  mergeStatus.textContent='Enviando e organizando';
  const fd=new FormData();
  mergeFiles.forEach(it=>fd.append('files', it.file));
  try{
    const r=await fetch('/merge',{method:'POST',body:fd});
    const js=await r.json();
    if(js.ok){
      mergeStatus.textContent=t('ready');
      notifyTaskDone();
      mergeResult.classList.remove('hidden');
      mergeResult.innerHTML=t('merge_success', { link: js.link, download: t('download') });
      const mergeFn=(js.link||'').split('/').pop();
      if(mergeFn) triggerAutoDownload(mergeFn);
      mergeFiles=[];
      renderMergeList();
    } else {
      showErr(mergeErr, extractMessage(js, 'organize_failed'));
      mergeStatus.textContent='';
    }
  }catch(e){
    showErr(mergeErr, t('error_prefix', { error: e }));
    mergeStatus.textContent='';
  }
});

