/* ===== Helpers ===== */
const MAX_MB = window.APP_CONFIG.maxMb;
const ACCEPT_EXT = ['pdf','jpg','jpeg','png','tif','tiff'];
const ACCEPT_VIDEO = ['mp4','mov','mkv','avi','webm'];

function extOk(name){ const e=(name.split('.').pop()||'').toLowerCase(); return ACCEPT_EXT.includes(e); }
function extOkVideo(name){ const e=(name.split('.').pop()||'').toLowerCase(); return ACCEPT_VIDEO.includes(e); }
function sizeOk(file){ return file.size <= MAX_MB*1024*1024; }

function showErr(el, msg){ el.textContent = msg; el.classList.remove('hidden'); }
function hideErr(el){ el.classList.add('hidden'); el.textContent=''; }

async function fetchJsonSafe(url, options){
  const response = await apiFetch(url, options);
  const text = await response.text();

  let data = null;
  try{
    data = text ? JSON.parse(text) : null;
  }catch{
    const status = response && response.status ? `HTTP ${response.status}` : t('invalid_server_response');
    const snippet = (text || '').trim().slice(0, 80);
    throw new Error(
      snippet.startsWith('<')
        ? t('unexpected_html', { status, snippet })
        : t('invalid_response_snippet', { status, snippet })
    );
  }

  return { response, data };
}

function fmtBytes(bytes){
  const b = Number(bytes)||0;
  if(b < 1024) return b + " B";
  const kb = b/1024;
  if(kb < 1024) return kb.toFixed(kb>=10?0:1) + " KB";
  const mb = kb/1024;
  if(mb < 1024) return mb.toFixed(mb>=10?0:1) + " MB";
  const gb = mb/1024;
  return gb.toFixed(gb>=10?0:1) + " GB";
}


function setSkeleton(el, on=true){ if(!el) return; el.classList.toggle('skeleton', !!on); }

function triggerAutoDownload(outName){
  const safeName = String(outName || '').trim();
