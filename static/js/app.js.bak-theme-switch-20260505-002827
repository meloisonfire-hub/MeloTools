async function pollYoutubeJob(jobId){
  const { data: js } = await fetchJsonSafe(`/youtube/progress/${encodeURIComponent(jobId)}`, { method:'GET' });
  if(!js.ok || !js.job){
    throw new Error(extractMessage(js, 'progress_check_failed'));
  }

  const job = js.job;
  setYoutubeProgress(job.progress || 0, extractMessage(job, 'processing_generic'));

  if(job.status === 'done'){
    stopYoutubePolling();
    youtubeProgressRow.classList.add('hidden');
    youtubeResult.classList.remove('hidden');
    const outName = (job.result && job.result.out_name) || 'arquivo';
    youtubeResult.innerHTML = `<a class="btn" href="/results/${encodeURIComponent(outName)}" download="${escapeHtml(outName)}">${t('download')}</a>`;
    triggerAutoDownload(outName);
    youtubeStatus.textContent = '';
    return true;
  }

  if(job.status === 'error'){
    stopYoutubePolling();
    youtubeProgressRow.classList.add('hidden');
    showErr(youtubeErr, extractMessage(job));
    youtubeStatus.textContent = '';
    return true;
  }

  return false;
}

async function pollYoutubeBatchJob(jobId){
  const { data: js } = await fetchJsonSafe(`/youtube/batch/progress/${encodeURIComponent(jobId)}`, { method:'GET' });
  if(!js.ok || !js.job){
    throw new Error(extractMessage(js, 'progress_check_failed'));
