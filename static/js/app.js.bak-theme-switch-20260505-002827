function loadImageFromFile(file){
  return new Promise((resolve, reject)=>{
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = ()=>{
      URL.revokeObjectURL(url);
      resolve(img);
    };
    img.onerror = ()=>{
      URL.revokeObjectURL(url);
      reject(new Error(t('preview_load_failed')));
    };
    img.src = url;
  });
}

function averageRemoveBgBorderColor(data, width, height){
  let totalR = 0, totalG = 0, totalB = 0, count = 0;
  const points = [];

  for(let x=0; x<width; x++){
    points.push([x, 0]);
    if(height > 1) points.push([x, height - 1]);
  }
  for(let y=1; y<height - 1; y++){
    points.push([0, y]);
    if(width > 1) points.push([width - 1, y]);
  }

  const step = Math.max(1, Math.floor(points.length / 1000));
  for(let i=0; i<points.length; i+=step){
    const [x, y] = points[i];
    const idx = (y * width + x) * 4;
    const a = data[idx + 3];
    if(a <= 8) continue;
    totalR += data[idx];
    totalG += data[idx + 1];
    totalB += data[idx + 2];
    count++;
  }

  if(!count) return [255, 255, 255];
  return [
    Math.round(totalR / count),
    Math.round(totalG / count),
    Math.round(totalB / count)
  ];
}

function buildRemoveBgPreview(){
  if(!removeBgPreviewImage) return;

  const img = removeBgPreviewImage;
  const maxSide = 420;
  const scale = Math.min(1, maxSide / Math.max(img.naturalWidth || img.width, img.naturalHeight || img.height));
  const width = Math.max(1, Math.round((img.naturalWidth || img.width) * scale));
  const height = Math.max(1, Math.round((img.naturalHeight || img.height) * scale));

  const workCanvas = document.createElement('canvas');
  workCanvas.width = width;
  workCanvas.height = height;
  const workCtx = workCanvas.getContext('2d', { willReadFrequently: true });
  workCtx.drawImage(img, 0, 0, width, height);

  const imageData = workCtx.getImageData(0, 0, width, height);
  const data = imageData.data;
  const bg = averageRemoveBgBorderColor(data, width, height);
  const strength = getRemoveBgStrength();
  const tolerance = 28 + Math.round(strength * 0.92);
  const toleranceSq = tolerance * tolerance;
  const visited = new Uint8Array(width * height);
  const queue = [];
  let head = 0;
  const bgMask = new Uint8Array(width * height);

  function distSq(i){
    const dr = data[i] - bg[0];
    const dg = data[i + 1] - bg[1];
    const db = data[i + 2] - bg[2];
    return dr * dr + dg * dg + db * db;
  }

  function similar(x, y){
    const i = (y * width + x) * 4;
    if(data[i + 3] <= 8) return true;
    if(distSq(i) <= toleranceSq) return true;
    const brightnessGap = Math.abs((data[i] + data[i + 1] + data[i + 2]) - (bg[0] + bg[1] + bg[2]));
    return brightnessGap <= Math.max(18, Math.round(tolerance / 2)) && distSq(i) <= Math.pow(tolerance + 18, 2);
  }

  for(let x=0; x<width; x++){
    queue.push([x, 0]);
    if(height > 1) queue.push([x, height - 1]);
  }
  for(let y=0; y<height; y++){
    queue.push([0, y]);
    if(width > 1) queue.push([width - 1, y]);
  }

  while(head < queue.length){
    const [x, y] = queue[head++];
    const pos = y * width + x;
    if(visited[pos]) continue;
    visited[pos] = 1;
    if(!similar(x, y)) continue;

    bgMask[pos] = 1;
    if(x > 0) queue.push([x - 1, y]);
    if(x + 1 < width) queue.push([x + 1, y]);
    if(y > 0) queue.push([x, y - 1]);
    if(y + 1 < height) queue.push([x, y + 1]);
  }

  const alphaMap = new Uint8ClampedArray(width * height);
  for(let y=0; y<height; y++){
    for(let x=0; x<width; x++){
      const pos = y * width + x;
      const i = pos * 4;
      let alpha = data[i + 3];
      if(bgMask[pos]){
        alpha = 0;
      }else{
        let nearBg = 0;
        for(let ny=Math.max(0, y - 1); ny<=Math.min(height - 1, y + 1); ny++){
          for(let nx=Math.max(0, x - 1); nx<=Math.min(width - 1, x + 1); nx++){
            if(bgMask[ny * width + nx]) nearBg++;
          }
        }
        if(nearBg > 0){
          alpha = Math.max(0, alpha - nearBg * (14 + Math.round(strength * 0.18)));
        }
      }
      alphaMap[pos] = alpha;
    }
  }

  const output = new ImageData(width, height);
  for(let pos=0; pos<alphaMap.length; pos++){
    const i = pos * 4;
    const alpha = alphaMap[pos];
    const alphaRatio = alpha / 255;

    if(alpha <= 0){
      output.data[i] = 0;
      output.data[i + 1] = 0;
      output.data[i + 2] = 0;
      output.data[i + 3] = 0;
      continue;
    }

    let r = data[i];
    let g = data[i + 1];
    let b = data[i + 2];

    if(alpha < 250){
      r = Math.max(0, Math.min(255, (r - bg[0] * (1 - alphaRatio)) / Math.max(alphaRatio, 0.01)));
      g = Math.max(0, Math.min(255, (g - bg[1] * (1 - alphaRatio)) / Math.max(alphaRatio, 0.01)));
      b = Math.max(0, Math.min(255, (b - bg[2] * (1 - alphaRatio)) / Math.max(alphaRatio, 0.01)));
    }

    output.data[i] = Math.round(r);
    output.data[i + 1] = Math.round(g);
    output.data[i + 2] = Math.round(b);
    output.data[i + 3] = alpha;
  }

  removeBgPreviewCanvas.width = width;
  removeBgPreviewCanvas.height = height;
  const previewCtx = removeBgPreviewCanvas.getContext('2d');
  previewCtx.clearRect(0, 0, width, height);
  previewCtx.putImageData(output, 0, 0);
}

