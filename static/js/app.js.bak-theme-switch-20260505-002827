document.addEventListener('paste', e=>{
  const cd=e.clipboardData||(e.originalEvent&&e.originalEvent.clipboardData);
  if(!cd) return;
  let n=0;
  for(const it of (cd.items||[])){
    if(it.kind==='file'){
      const f=it.getAsFile();
      if(f){ sendFile(f); n++; }
    }
  }
  if(n>0) e.preventDefault();
});

