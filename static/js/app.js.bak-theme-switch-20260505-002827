function createRow(name){
  const row=document.createElement('div');
  row.className='row';
  row.innerHTML = `
    <div class="name" title="${name}">${name}</div>
    <div class="progress"><div></div></div>
    <div class="status"><span class="txt">Enviando</span></div>
    <a class="btn hidden dl">${t('download')}</a>
  `;
  list.prepend(row);
  return row;
}

function setStatus(row, text, isErr=false){
  const s=row.querySelector('.status .txt');
  s.textContent=text;
  s.classList.toggle('err', !!isErr);
}

function setProgress(row,p){
  row.querySelector('.progress>div').style.width = p+'%';
}

function setLink(row,href){
  const a=row.querySelector('.dl');
  a.href=href;
  a.classList.remove('hidden');
  const fn=(href||'').split('/').pop();
  if(fn) triggerAutoDownload(fn);
}

function validateFile(f){
  if(!extOk(f.name)){ showErr(ocrErr,t('unsupported_pdf_image')); return false; }
  if(!sizeOk(f)){ showErr(ocrErr,t('file_limit', { max_mb: MAX_MB })); return false; }
  hideErr(ocrErr);
  return true;
}

function updateBatch(){
  (pendingUploads===0 && batchOK.length>0)
    ? batchActions.classList.remove('hidden')
    : batchActions.classList.add('hidden');
}

async function downloadAllSeq(listNames){
  for(const name of listNames){
    const a=document.createElement('a');
    a.href='/results/'+encodeURIComponent(name);
    a.download=name;
    document.body.appendChild(a);
    a.click();
    a.remove();
    await new Promise(r=>setTimeout(r,250));
  }
}

dlAll.addEventListener('click', ()=>downloadAllSeq(batchOK));

function sendFile(f){
  if(!validateFile(f)) return;
  const row=createRow(f.name);
  pendingUploads++;
  const xhr=new XMLHttpRequest();
  const fd=new FormData();
  fd.append('file',f);

  xhr.upload.onprogress = e=>{
    if(e.lengthComputable){
      setProgress(row, Math.round(e.loaded*100/e.total));
    }
  };

  xhr.onreadystatechange=()=>{
    if(xhr.readyState===4){
      if(xhr.status===200){
        try{
          const js=JSON.parse(xhr.responseText);
          if(js.ok){
            setStatus(row,t('processing_ocr'));
            pulseProgress(row);
            setTimeout(()=>{
              stopPulseProgress(row);
              setProgress(row,100);
              setStatus(row,t('ready'));
              setLink(row,js.link);
              const fn=(js.link||'').split('/').pop();
              if(fn) batchOK.push(fn);
              pendingUploads--;
              updateBatch();
            },120);
          } else {
            stopPulseProgress(row);
            setStatus(row,extractMessage(js),true);
            pendingUploads--;
            updateBatch();
          }
        }catch{
          stopPulseProgress(row);
          setStatus(row,t('invalid_server_response'),true);
          pendingUploads--;
          updateBatch();
        }
      } else {
        try{
          const r=JSON.parse(xhr.responseText);
          stopPulseProgress(row);
          setStatus(row, extractMessage(r) || ('HTTP '+xhr.status), true);
        }catch{
          stopPulseProgress(row);
          setStatus(row, 'HTTP '+xhr.status, true);
        }
        pendingUploads--;
        updateBatch();
      }
    }
  };

  xhr.open('POST','/upload',true);
  xhr.setRequestHeader('X-Lang', I18N.getLanguage());
  xhr.send(fd);
}

['dragenter','dragover'].forEach(ev=>drop.addEventListener(ev,e=>{
