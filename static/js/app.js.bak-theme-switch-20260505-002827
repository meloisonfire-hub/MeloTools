  const job = js.job;
  renderYoutubeBatchItems(job);
  setYoutubeProgress(job.progress || 0, extractMessage(job, 'youtube_batch_running'));

  if(job.status === 'done'){
    stopYoutubeBatchPolling();
    youtubeProgressRow.classList.add('hidden');
