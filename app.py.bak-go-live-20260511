@app.route("/api/documents/pdf-to-image", methods=["POST"])
def pdf_to_image():
    p, err = get_file("file", "pdf")
    if err:
        return fail(err)
    try:
        from pdf2image import convert_from_path
        pages = convert_from_path(str(p))
        out_dir = TMP_DIR / f"pdf-img-{uuid.uuid4().hex[:10]}"
        out_dir.mkdir(parents=True, exist_ok=True)
        for i, page in enumerate(pages, 1):
            page.save(out_dir / f"page-{i}.png", "PNG")
        zip_path = RESULT_DIR / f"pdf-to-image-{uuid.uuid4().hex[:10]}.zip"
        shutil.make_archive(str(zip_path).replace(".zip", ""), "zip", out_dir)
        return ok_file(zip_path)
    except Exception:
        # Fallback: render extracted text into a PNG
        try:
            reader = PdfReader(str(p))
            txt = "\n".join((pg.extract_text() or "") for pg in reader.pages).strip() or "PDF sem texto extraivel."
            img = Image.new("RGB", (1400, 1800), "white")
            draw = ImageDraw.Draw(img)
            lines = txt.splitlines()[:80]
            y = 30
            for ln in lines:
                draw.text((30, y), ln[:140], fill="black")
                y += 20
            out = RESULT_DIR / f"pdf-to-image-fallback-{uuid.uuid4().hex[:10]}.png"
            img.save(out, "PNG")
            return ok_file(out)
        except Exception as e:
            return fail(f"Falha ao converter PDF: {e}")


@app.route("/api/documents/number-pages", methods=["POST"])
def number_pages():
    p, err = get_file("file", "pdf")
    if err:
        return fail(err)
    position = (request.form.get("position") or "footer-right").strip().lower()
    reader = read_pdf(p)
    writer = PdfWriter()

    for idx, pg in enumerate(reader.pages, start=1):
        width = float(pg.mediabox.width)
        height = float(pg.mediabox.height)
        packet = io.BytesIO()
        c = canvas.Canvas(packet, pagesize=(width, height))
        text = str(idx)
        if position == "footer-center":
            x, y = width / 2 - 6, 20
        elif position == "footer-left":
            x, y = 20, 20
        else:
            x, y = width - 30, 20
        c.setFont("Helvetica", 10)
        c.drawString(x, y, text)
        c.save()
        packet.seek(0)
        overlay = PdfReader(packet)
        pg.merge_page(overlay.pages[0])
        writer.add_page(pg)

    out = RESULT_DIR / f"number-pages-{uuid.uuid4().hex[:10]}.pdf"
    with out.open("wb") as f:
        writer.write(f)
    return ok_file(out)


