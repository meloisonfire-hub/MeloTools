@app.route("/api/online/download", methods=["POST"])
def online_download():
    url = (request.form.get("url") or "").strip()
    mode = (request.form.get("mode") or "video").strip().lower()
    quality = (request.form.get("quality") or "720").strip()
    if not url:
        return fail("Informe a URL do vídeo.")
    if url.startswith("mock://"):
        ext = "mp3" if mode == "audio" else "mp4"
        out = RESULT_DIR / f"download-mock-{uuid.uuid4().hex[:10]}.{ext}"
        out.write_bytes(b"mock")
        return ok_file(out)

    outtmpl = str(RESULT_DIR / f"download-{uuid.uuid4().hex[:8]}.%(ext)s")
    cmd = ["yt-dlp", "-o", outtmpl, url]
    if mode == "audio":
        cmd = ["yt-dlp", "-x", "--audio-format", "mp3", "-o", outtmpl, url]
    else:
        cmd = ["yt-dlp", "-f", f"bestvideo[height<={quality}]+bestaudio/best[height<={quality}]", "-o", outtmpl, url]
    try:
        subprocess.run(cmd, check=True, capture_output=True, text=True)
    except Exception as e:
        return fail(f"Falha ao baixar vídeo: {e}")

    files = sorted(RESULT_DIR.glob("download-*"), key=lambda x: x.stat().st_mtime, reverse=True)
    if not files:
        return fail("Download finalizado, mas arquivo não foi localizado.")
    return ok_file(files[0])


