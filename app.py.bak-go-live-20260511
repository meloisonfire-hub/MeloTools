ALLOWED = {
    "pdf": {".pdf"},
    "image": {".png", ".jpg", ".jpeg", ".webp", ".bmp", ".tiff", ".gif"},
    "video": {".mp4", ".mov", ".mkv", ".avi", ".webm", ".m4v"},
    "doc": {".doc", ".docx", ".odt"},
}


def uid(name: str) -> str:
    stem = re.sub(r"[^a-zA-Z0-9_-]", "-", Path(name).stem)[:40] or "file"
    return f"{stem}-{uuid.uuid4().hex[:10]}"


def fail(msg: str, code: int = 400):
    return jsonify({"ok": False, "message": msg}), code


def ok_file(path: Path):
    return jsonify({"ok": True, "filename": path.name, "url": f"/results/{path.name}"})


def ffmpeg_cmd() -> str:
    try:
        return imageio_ffmpeg.get_ffmpeg_exe()
    except Exception:
        return "ffmpeg"


def get_file(field: str, kind: str):
    f = request.files.get(field)
    if not f or not f.filename:
        return None, "Arquivo não enviado."
    ext = Path(f.filename).suffix.lower()
    if ext not in ALLOWED[kind]:
        return None, f"Extensão não permitida para {kind}: {ext}"
    out = UPLOAD_DIR / f"{uid(f.filename)}{ext}"
    f.save(out)
    return out, None


def get_files(field: str, kind: str):
    files = request.files.getlist(field)
    if not files:
        return None, "Nenhum arquivo enviado."
    out = []
    for f in files:
        if not f or not f.filename:
            continue
        ext = Path(f.filename).suffix.lower()
        if ext not in ALLOWED[kind]:
            return None, f"Extensão não permitida: {ext}"
        p = UPLOAD_DIR / f"{uid(f.filename)}{ext}"
        f.save(p)
        out.append(p)
    if not out:
        return None, "Nenhum arquivo válido recebido."
    return out, None


