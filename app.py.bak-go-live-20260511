@app.route("/api/text/process", methods=["POST"])
def text_process():
    text = request.form.get("text", "")
    action = (request.form.get("text_action") or "chars").strip()

    if action == "chars":
        return jsonify({"ok": True, "result": f"Total de caracteres: {len(text)}"})
    if action == "words":
        n = len(re.findall(r"\S+", text))
        return jsonify({"ok": True, "result": f"Total de palavras: {n}"})
    if action == "trim_lines":
        out = " ".join([x.strip() for x in text.splitlines() if x.strip()])
        return jsonify({"ok": True, "result": out})
    if action == "trim_spaces":
        out = re.sub(r"\s+", " ", text).strip()
        return jsonify({"ok": True, "result": out})
    if action == "upper":
        return jsonify({"ok": True, "result": text.upper()})
    if action == "lower":
        return jsonify({"ok": True, "result": text.lower()})
    if action == "capitalize":
        return jsonify({"ok": True, "result": text.title()})
    if action == "sort":
        lines = [x.strip() for x in text.splitlines() if x.strip()]
        return jsonify({"ok": True, "result": "\n".join(sorted(lines, key=str.lower))})
    if action == "dedupe":
        lines = [x.strip() for x in text.splitlines() if x.strip()]
        seen, out = set(), []
        for ln in lines:
            if ln.lower() in seen:
                continue
            seen.add(ln.lower())
            out.append(ln)
        return jsonify({"ok": True, "result": "\n".join(out)})
    if action == "lorem":
        words = [
            "lorem", "ipsum", "dolor", "sit", "amet", "consectetur", "adipiscing", "elit",
            "sed", "do", "eiusmod", "tempor", "incididunt", "ut", "labore", "et", "dolore", "magna", "aliqua"
        ]
        out = " ".join(random.choice(words) for _ in range(120)).capitalize() + "."
        return jsonify({"ok": True, "result": out})

    return fail("Ação de texto inválida.")


