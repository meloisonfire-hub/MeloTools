def ffprobe_cmd() -> str:
    ff = ffmpeg_cmd()
    p = Path(ff)
    candidates = [
        p.with_name("ffprobe"),
        p.with_name("ffprobe.exe"),
        Path(str(ff).replace("ffmpeg", "ffprobe")),
    ]
    for c in candidates:
        if c.exists():
            return str(c)
    return "ffprobe"


@app.route("/api/videos/split", methods=["POST"])
def split_video():
    p, err = get_file("file", "video")
    if err:
        return fail(err)
    size_mb = float(request.form.get("size_mb") or 100)
    if size_mb <= 1:
        return fail("Tamanho por parte deve ser maior que 1 MB")
    # probe duration with ffprobe
    try:
        probe = subprocess.run(
            [ffprobe_cmd(), "-v", "error", "-show_entries", "format=duration", "-of", "default=nk=1:nw=1", str(p)],
            check=True,
            capture_output=True,
            text=True,
        )
        duration = float((probe.stdout or "0").strip())
    except Exception:
        # Fallback: parse duration from ffmpeg stderr
        try:
            p2 = subprocess.run([ffmpeg_cmd(), "-i", str(p)], capture_output=True, text=True)
            m = re.search(r"Duration:\\s*(\\d+):(\\d+):(\\d+\\.?\\d*)", (p2.stderr or ""))
            if not m:
                return fail("Falha ao ler duração do vídeo.")
            hh, mm, ss = m.groups()
            duration = int(hh) * 3600 + int(mm) * 60 + float(ss)
        except Exception as e:
            return fail(f"Falha ao ler duração do vídeo: {e}")
    if duration <= 0:
        return fail("Duração inválida para dividir vídeo.")
    bytes_total = p.stat().st_size
    sec_part = max(1, int(duration * (size_mb * 1024 * 1024 / bytes_total)))
    out_dir = TMP_DIR / f"split-video-{uuid.uuid4().hex[:10]}"
    out_dir.mkdir(parents=True, exist_ok=True)
    start = 0
    idx = 1
    while start < duration:
        end = min(duration, start + sec_part)
        part_path = out_dir / f"part-{idx}.mp4"
        cmd = [ffmpeg_cmd(), "-y", "-ss", str(start), "-to", str(end), "-i", str(p), "-c", "copy", str(part_path)]
        try:
            subprocess.run(cmd, check=True, capture_output=True, text=True)
        except Exception:
            # fallback re-encode if stream copy fails
            cmd2 = [ffmpeg_cmd(), "-y", "-ss", str(start), "-to", str(end), "-i", str(p), "-c:v", "libx264", "-c:a", "aac", str(part_path)]
            subprocess.run(cmd2, check=True, capture_output=True, text=True)
        idx += 1
        start = end
    zip_path = RESULT_DIR / f"split-video-{uuid.uuid4().hex[:10]}.zip"
    shutil.make_archive(str(zip_path).replace(".zip", ""), "zip", out_dir)
    return ok_file(zip_path)


