def read_pdf(file_path: Path):
    try:
        return PdfReader(str(file_path))
    except Exception as e:
        raise RuntimeError(f"PDF inválido: {e}")


@app.route("/api/documents/ocr-pdf", methods=["POST"])
def ocr_pdf():
    p, err = get_file("file", "pdf")
    if err:
        return fail(err)
    # First choice: image-based OCR to searchable PDF
    try:
        from pdf2image import convert_from_path
        import pytesseract
        pages = convert_from_path(str(p))
        writer = PdfWriter()
        for page in pages:
            pdf_bytes = pytesseract.image_to_pdf_or_hocr(page, extension="pdf")
            tmp_pdf = TMP_DIR / f"ocr-page-{uuid.uuid4().hex[:10]}.pdf"
            with tmp_pdf.open("wb") as f:
                f.write(pdf_bytes)
            page_reader = PdfReader(str(tmp_pdf))
            writer.add_page(page_reader.pages[0])
        out = RESULT_DIR / f"ocr-pdf-{uuid.uuid4().hex[:10]}.pdf"
        with out.open("wb") as f:
            writer.write(f)
        return ok_file(out)
    except Exception:
        # Fallback: extract embedded text and generate TXT output
        try:
            reader = PdfReader(str(p))
            text_parts = []
            for i, pg in enumerate(reader.pages, start=1):
                text_parts.append(f"--- Página {i} ---")
                text_parts.append(pg.extract_text() or "")
                text_parts.append("")
            out_txt = RESULT_DIR / f"ocr-fallback-{uuid.uuid4().hex[:10]}.txt"
            out_txt.write_text("\n".join(text_parts).strip(), encoding="utf-8")
            return ok_file(out_txt)
        except Exception as e:
            return fail(f"Falha durante OCR: {e}")


