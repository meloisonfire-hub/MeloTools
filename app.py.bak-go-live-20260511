@app.route("/api/image/remove-bg", methods=["POST"])
def remove_bg():
    p, err = get_file("file", "image")
    if err:
        return fail(err)
    img = Image.open(p).convert("RGBA")
    pix = img.load()
    w, h = img.size
    threshold = int(request.form.get("strength") or 35)

    # Simple near-white background removal
    for y in range(h):
        for x in range(w):
            r, g, b, a = pix[x, y]
            if r > 255 - threshold and g > 255 - threshold and b > 255 - threshold:
                pix[x, y] = (r, g, b, 0)

    out = RESULT_DIR / f"remove-bg-{uuid.uuid4().hex[:10]}.png"
    img.save(out)
    return ok_file(out)


