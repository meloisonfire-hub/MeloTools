[Unit]
Description=MeloTools web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=melotools
Group=melotools
WorkingDirectory=/srv/melotools
EnvironmentFile=-/etc/melotools.env
Environment="PATH=/srv/melotools/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="HOME=/var/lib/melotools"
Environment="MELOTOOLS_SECRET_KEY_FILE=/etc/melotools.secret"
Environment="MELOTOOLS_RUNTIME_DIR=/var/lib/melotools"
Environment="MELOTOOLS_UPLOAD_DIR=/var/lib/melotools/uploads"
Environment="MELOTOOLS_RESULT_DIR=/var/lib/melotools/results"
Environment="PLAYWRIGHT_BROWSERS_PATH=/var/lib/melotools/ms-playwright"
ExecStart=/srv/melotools/venv/bin/gunicorn --worker-class gthread --workers 2 --threads 4 --timeout 900 --graceful-timeout 60 --keep-alive 10 --max-requests 300 --max-requests-jitter 50 --bind 127.0.0.1:8090 app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3
TimeoutStopSec=75

StateDirectory=melotools
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/melotools
LimitNOFILE=65535
TasksMax=128
MemoryMax=800M

[Install]
WantedBy=multi-user.target
