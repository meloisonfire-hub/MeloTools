    <section id="tab-ocr" class="section" data-category="pdf">
      <h2 class="title" data-i18n="ocr_title">Converta PDFs e imagens em documentos pesquis&aacute;veis (OCR)</h2>
      <p class="sub" data-i18n="ocr_sub" data-i18n-vars='{{ {"max_mb": max_mb}|tojson }}'>Tamanho m&aacute;ximo de {{max_mb}} MB por arquivo</p>
      <div id="drop" class="drop">
        <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 16l4-5h-3V4h-2v7H8l4 5zM5 18h14v2H5z"/></svg>
        <form class="inline" enctype="multipart/form-data">
          <input type="file" id="file" multiple accept=".pdf,.jpg,.jpeg,.png,.tif,.tiff" hidden>
          <button class="btn" type="button" id="choose" data-i18n="upload_cta">Selecione arquivos, arraste para esta area ou cole aqui</button>
        </form>
        <div id="ocrErr" class="errmsg hidden"></div>
      </div>
      <div id="list"></div>
      <div id="batchActions" class="inputs hidden" style="margin-top:10px; gap:10px;">
        <button class="btn" id="dlAll" data-i18n="download_all">Baixar todos</button>
      </div>
      <p class="note" data-i18n="ocr_note">Formatos suportados: PDF, PNG, JPG, JPEG, TIFF</p>
    </section>

    <section id="tab-merge" class="section" data-category="pdf">
      <h2 class="title" data-i18n="merge_title">Organize PDFs e imagens em um &uacute;nico PDF</h2>
      <p class="sub" data-i18n="merge_sub">Adicione, una, remova e arraste para reordenar antes de gerar o arquivo final</p>
      <div id="dropMerge" class="drop">
        <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M3 7h8v2H3V7zm0 4h8v2H3v-2zm0 4h8v2H3v-2zM13 7h8v8h-8V7zm2 2v4h4V9h-4z"/></svg>
        <form class="inline" enctype="multipart/form-data">
          <input type="file" id="filesMerge" multiple accept=".pdf,.jpg,.jpeg,.png,.tif,.tiff" hidden>
          <button class="btn" type="button" id="chooseMerge" data-i18n="upload_cta">Selecione arquivos, arraste para esta area ou cole aqui</button>
        </form>
        <div id="mergeErr" class="errmsg hidden"></div>
      </div>
      <div id="mergeList"></div>
      <div class="inputs" style="margin-top:10px">
        <button class="btn" id="runMerge" data-i18n="generate_pdf">Gerar PDF</button>
        <span id="mergeStatus" class="small"></span>
      </div>
      <p id="mergeResult" class="note hidden"></p>
    </section>

    <section id="tab-rotate" class="section" data-category="pdf">
      <h2 class="title" data-i18n="rotate_title">Girar PDFs/Imagens</h2>
      <p class="sub" data-i18n="rotate_sub">Rotacione aqui seus arquivos</p>
      <div id="dropRotate" class="drop">
        <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 6V3L8 7l4 4V8c2.76 0 5 2.24 5 5a5 5 0 11-9.9-1H5.02a7 7 0 1013.96-1A7 7 0 0012 6z"/></svg>
        <form class="inline" enctype="multipart/form-data">
          <input type="file" id="filesRotate" multiple accept=".pdf,.jpg,.jpeg,.png,.tif,.tiff" hidden>
          <button class="btn" type="button" id="chooseRotate" data-i18n="upload_cta">Selecione arquivos, arraste para esta area ou cole aqui</button>
        </form>
        <div id="rotateErr" class="errmsg hidden"></div>
      </div>
      <div id="rotateList"></div>
      <div class="inputs" style="margin-top:10px">
        <button class="btn" id="runRotate" data-i18n="rotate_now">Girar agora</button>
        <span id="rotateStatus" class="small"></span>
      </div>
      <div id="rotateOut" class="note hidden"></div>
      <div id="rotateBatch" class="inputs hidden" style="margin-top:10px">
        <button class="btn" id="rotateDlAll" data-i18n="download_all">Baixar todos</button>
      </div>
    </section>

    <section id="tab-split" class="section" data-category="pdf">
      <h2 class="title" data-i18n="split_title">Particionar PDF/Imagens</h2>
      <p class="sub" data-i18n="split_sub">Envie seus PDFs ou imagens e escolha o modo de particionamento</p>
      <div id="dropSplit" class="drop">
        <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M10 3h4v2h-4V3zM3 10h2v4H3v-4zm16 0h2v4h-2v-4zM10 19h4v2h-4v-2zM7 7h10v10H7V7z"/></svg>
        <form class="inline" enctype="multipart/form-data">
          <input type="file" id="fileSplit" multiple accept=".pdf,.jpg,.jpeg,.png,.tif,.tiff" hidden>
          <button class="btn" type="button" id="chooseSplit" data-i18n="upload_cta">Selecione arquivos, arraste para esta area ou cole aqui</button>
        </form>
        <div id="splitErr" class="errmsg hidden"></div>
      </div>
      <div class="inputs">
        <label><input type="radio" name="mode" value="size" checked> <span data-i18n="split_mode_size">por tamanho (MB)</span></label>
        <input type="number" id="maxmb" min="1" step="1" placeholder="ex.: 6" data-i18n-placeholder="example_size">
      </div>
      <div class="inputs">
        <label><input type="radio" name="mode" value="every"> <span data-i18n="split_mode_every">intervalo fixo</span></label>
        <input type="number" id="every" min="1" step="1" placeholder="ex.: 5" data-i18n-placeholder="example_every">
      </div>
      <div class="inputs">
        <label><input type="radio" name="mode" value="ranges"> <span data-i18n="split_mode_ranges">intervalo personalizado</span></label>
        <input type="text" id="ranges" placeholder="ex.: 1-3,7,10-12" data-i18n-placeholder="example_ranges">
      </div>
      <div class="inputs">
        <button class="btn" id="runSplit" data-i18n="split_action">Particionar</button>
        <span id="splitStatus" class="small"></span>
      </div>
      <div id="splitList"></div>
      <div id="splitBatch" class="inputs hidden" style="margin-top:10px">
        <button class="btn" id="splitDlAll" data-i18n="download_all">Baixar todos</button>
      </div>
    </section>

    <section id="tab-compress" class="section" data-category="pdf">
      <h2 class="title" data-i18n="compress_title">Comprimir PDFs</h2>
      <p class="sub" data-i18n="compress_sub">Escolha o n&iacute;vel e envie um ou mais arquivos</p>
      <div id="dropCompress" class="drop">
        <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M7 3h10v2H7V3zm-2 4h14v2H5V7zm2 4h10v10H7V11z"/></svg>
        <form class="inline" enctype="multipart/form-data">
          <input type="file" id="filesCompress" multiple accept=".pdf" hidden>
          <button class="btn" type="button" id="chooseCompress" data-i18n="upload_cta">Selecione arquivos, arraste para esta area ou cole aqui</button>
        </form>
        <div id="compressErr" class="errmsg hidden"></div>
      </div>
      <div class="inputs" style="margin-top:10px; align-items:center; gap:10px;">
        <label data-i18n="compress_level">N&iacute;vel de compress&atilde;o:</label>
        <select id="compressQuality">
          <option value="screen" data-i18n="compress_max">M&aacute;xima</option>
          <option value="ebook" selected data-i18n="compress_high">Alta</option>
          <option value="printer" data-i18n="compress_medium">M&eacute;dia</option>
          <option value="prepress" data-i18n="compress_low">Baixa</option>
        </select>
        <button class="btn" id="runCompress" data-i18n="compress_now">Comprimir agora</button>
