def format_cache_path(key: str) -> Path:
    return FORMAT_CACHE_DIR / f"{key}.json"


def read_format_cache(key: str, ttl_seconds: int = 21600):
    path = format_cache_path(key)
    if not path.exists():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8") or "{}")
        created = float(data.pop("created_at", 0) or 0)
        if created and (datetime.now().timestamp() - created) <= ttl_seconds:
            return data
    except Exception:
        return None
    return None


def write_format_cache(key: str, data: dict) -> None:
