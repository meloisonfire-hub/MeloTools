def ffmpeg_base_cmd() -> list[str]:
    # Quiet/stable execution for long jobs; avoid interactive stdin hangs.
    return [ffmpeg_cmd(), "-nostdin", "-hide_banner", "-loglevel", "error"]


def run_cmd(cmd: list[str], timeout: int | None = None, capture: bool = False):
    t = timeout or int(os.getenv("MELOTOOLS_CMD_TIMEOUT", "3600"))
    if capture:
        return subprocess.run(cmd, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=t)
    return subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, timeout=t)







def format_cache_key(url: str) -> str:
