    return args

def is_threads_url(url: str) -> bool:
    value = (url or "").lower()
    return "threads.net/" in value or "threads.com/" in value

def normalize_online_url(url: str) -> str:
    # yt-dlp recognizes Threads primarily through threads.net.
    value = (url or "").strip()
    value = value.replace("https://www.threads.com/", "https://www.threads.net/").replace("https://threads.com/", "https://threads.net/")
    value = normalize_youtube_watch_url(value)
    return value


def normalize_youtube_watch_url(url: str) -> str:
    value = (url or '').strip()
    try:
        p = urllib.parse.urlparse(value)
        host = (p.netloc or '').lower()
        if 'youtube.com' in host and p.path == '/watch':
            q = urllib.parse.parse_qs(p.query)
            vid = (q.get('v') or [''])[0].strip()
            if vid:
                return f"https://www.youtube.com/watch?v={vid}"
    except Exception:
        pass
    return value

def normalize_format_height(value) -> int:
    try:
        return int(float(value or 0))
    except Exception:
        return 0


def video_quality_label(height: int) -> str:
    if height >= 2160:
        return f"{height}p - 4K"
    if height >= 1440:
        return f"{height}p - Quad HD"
    if height >= 1080:
        return f"{height}p - Full HD"
    if height >= 720:
        return f"{height}p - HD"
    return f"{height}p"


def extract_threads_payload(url: str) -> dict:
    if not THREADS_EXTRACTOR.exists():
        raise RuntimeError("Extrator do Threads n\u00e3o encontrado no servidor.")
    proc = subprocess.run(
        [sys.executable, str(THREADS_EXTRACTOR), url],
        check=False,
        capture_output=True,
        text=True,
        timeout=75,
    )
    raw = (proc.stdout or "").strip()
    try:
        payload = json.loads(raw or "{}")
    except Exception as exc:
        raise RuntimeError("O Threads respondeu, mas o servidor n\u00e3o conseguiu interpretar a m\u00eddia.") from exc
    if proc.returncode != 0 or not payload.get("ok"):
        raise RuntimeError(payload.get("message") or "N\u00e3o foi poss\u00edvel renderizar o post do Threads.")
    return payload


def ytdlp_info(url: str) -> dict:
    proc = subprocess.run(
        [ytdlp_cmd(), "--dump-single-json", "--no-warnings", "--no-playlist", url],
        check=False,
        capture_output=True,
        text=True,
        timeout=75,
    )
    if proc.returncode != 0:
        raise RuntimeError((proc.stderr or proc.stdout or "N\u00e3o foi poss\u00edvel analisar este link.").strip()[-500:])
    return json.loads(proc.stdout or "{}")


def online_format_options(url: str) -> dict:
    if is_threads_url(url):
        payload = extract_threads_payload(url)
        heights = []
        for item in payload.get("videos") or []:
            if isinstance(item, dict):
                h = normalize_format_height(item.get("height"))
                if h and h not in heights:
                    heights.append(h)
        heights = sorted(heights, reverse=True)
        videos = [{"value": str(h), "label": video_quality_label(h)} for h in heights]
        if not videos:
            videos = [{"value": "original", "label": "Original dispon\u00edvel no Threads"}]
        return {
            "title": payload.get("title") or "Threads",
            "video": videos,
            "audio": [{"value": "source", "label": "\u00c1udio original do v\u00eddeo"}],
            "source": "threads",
        }

    info = ytdlp_info(url)
    formats = info.get("formats") or []
    heights = set()
    audio_rates = set()
    for fmt in formats:
        vcodec = fmt.get("vcodec") or "none"
        acodec = fmt.get("acodec") or "none"
        height = normalize_format_height(fmt.get("height"))
        if height and vcodec != "none":
            heights.add(height)
        abr = fmt.get("abr") or fmt.get("asr")
        if acodec != "none" and vcodec == "none" and abr:
            try:
                audio_rates.add(int(round(float(abr))))
            except Exception:
                pass
    if not heights and info.get("height"):
        heights.add(normalize_format_height(info.get("height")))
    video = [{"value": str(h), "label": video_quality_label(h)} for h in sorted(heights, reverse=True) if h]
    audio = [{"value": str(a), "label": f"{a} kbps"} for a in sorted(audio_rates, reverse=True) if a]
    if not video:
        video = [{"value": "best", "label": "Melhor qualidade dispon\u00edvel"}]
    if not audio:
        audio = [{"value": "best", "label": "Melhor \u00c1udio dispon\u00edvel"}]
    return {
        "title": info.get("title") or "V\u00eddeo online",
        "video": video,
        "audio": audio,
        "source": info.get("extractor_key") or info.get("extractor") or "online",
    }

def threads_oembed_recognizes(url: str) -> bool:
    if not is_threads_url(url):
        return False
    endpoint = "https://graph.threads.net/oembed?url=" + urllib.parse.quote(url, safe="")
    req = urllib.request.Request(endpoint, headers={"User-Agent": "Mozilla/5.0"})
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            body = resp.read(4096).decode("utf-8", errors="ignore")
    except Exception:
        return False
    return "Threads" in body or "text-post-media" in body


def extract_threads_video_urls(url: str) -> list[str]:
    if not THREADS_EXTRACTOR.exists():
        raise RuntimeError("Extrator do Threads n\u00e3o encontrado no servidor.")
    proc = subprocess.run(
        [sys.executable, str(THREADS_EXTRACTOR), url],
        check=False,
        capture_output=True,
        text=True,
        timeout=75,
    )
    raw = (proc.stdout or "").strip()
    try:
        payload = json.loads(raw or "{}")
    except Exception as exc:
        raise RuntimeError("O Threads respondeu, mas o servidor n\u00e3o conseguiu interpretar a m\u00eddia.") from exc
    if proc.returncode != 0 or not payload.get("ok"):
        raise RuntimeError(payload.get("message") or "N\u00e3o foi poss\u00edvel renderizar o post do Threads.")
    urls = []
    for item in payload.get("videos") or []:
        if isinstance(item, dict):
            value = str(item.get("src") or item.get("url") or "").strip()
        else:
            value = str(item or "").strip()
        if value and value not in urls:
            urls.append(value)
    if not urls:
        raise RuntimeError("Nenhum v\u00eddeo público foi encontrado neste post do Threads.")
    return urls


def download_url_to_file(url: str, dest: Path, referer: str = "https://www.threads.net/") -> None:
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/124 Safari/537.36",
            "Referer": referer,
            "Accept": "video/mp4,video/*,*/*;q=0.8",
        },
    )
    with urllib.request.urlopen(req, timeout=120) as resp, dest.open("wb") as fh:
        shutil.copyfileobj(resp, fh)
    if dest.stat().st_size < 1024:
        raise RuntimeError("O arquivo retornado pelo Threads veio vazio ou incompleto.")


def zip_files(files: list[Path], prefix: str) -> Path:
    out = RESULT_DIR / f"{prefix}-{uuid.uuid4().hex[:8]}.zip"
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as zf:
        for path in files:
            zf.write(path, arcname=path.name)
    return out


def download_threads_media(url: str, mode: str, bitrate: str = "192") -> Path:
    media_urls = extract_threads_video_urls(url)
    downloaded: list[Path] = []
    for index, media_url in enumerate(media_urls, start=1):
        video_path = RESULT_DIR / f"threads-video-{uuid.uuid4().hex[:8]}-{index:02d}.mp4"
        download_url_to_file(media_url, video_path, referer=url)
        if mode == "audio":
            audio_path = RESULT_DIR / f"threads-audio-{uuid.uuid4().hex[:8]}-{index:02d}.mp3"
            ffmpeg_args = [ffmpeg_cmd(), "-y", "-i", str(video_path), "-vn", "-acodec", "libmp3lame"]
            if str(bitrate).isdigit():
                ffmpeg_args.extend(["-b:a", f"{bitrate}k"])
            ffmpeg_args.append(str(audio_path))
            subprocess.run(
                ffmpeg_args,
                check=True,
                capture_output=True,
                text=True,
            )
            downloaded.append(audio_path)
        else:
            downloaded.append(video_path)
    if len(downloaded) == 1:
        return downloaded[0]
    return zip_files(downloaded, "threads-midia" if mode != "audio" else "threads-audios")



def get_file(field: str, kind: str):
    ensure_runtime_dirs()
    f = request.files.get(field)
    if not f or not f.filename:
        return None, "Arquivo não enviado."
    ext = Path(f.filename).suffix.lower()
    if ext not in ALLOWED[kind]:
        return None, f"Extensão não permitida para {kind}: {ext}"
    out = UPLOAD_DIR / f"{uid(f.filename)}{ext}"
    f.save(out)
    return out, None


def get_files(field: str, kind: str):
    ensure_runtime_dirs()
    files = request.files.getlist(field)
    if not files:
        return None, "Nenhum arquivo enviado."
    out = []
    for f in files:
        if not f or not f.filename:
            continue
        ext = Path(f.filename).suffix.lower()
        if ext not in ALLOWED[kind]:
            return None, f"Extensão não permitida: {ext}"
        p = UPLOAD_DIR / f"{uid(f.filename)}{ext}"
        f.save(p)
        out.append(p)
    if not out:
        return None, "Nenhum arquivo válido recebido."
    return out, None


