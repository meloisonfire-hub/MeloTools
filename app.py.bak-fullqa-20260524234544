@app.route("/api/dev/hash", methods=["POST"])
def dev_hash():
    text = request.form.get("text", "")
    algorithm = (request.form.get("algorithm") or "sha256").lower().replace("-", "")
    allowed = {
        "md5": ("md5", "MD5"),
        "sha1": ("sha1", "SHA-1"),
        "sha256": ("sha256", "SHA-256"),
        "sha512": ("sha512", "SHA-512"),
    }
    if algorithm not in allowed:
        return fail("Algoritmo de hash não suportado.")
    if text == "":
        return fail("Informe um texto para gerar o hash.")
    internal, label = allowed[algorithm]
    digest = hashlib.new(internal, text.encode("utf-8")).hexdigest()
    return jsonify({"ok": True, "result": f"{label}: {digest}"})


