def job_path(job_id: str) -> Path:
    if not re.fullmatch(r"[a-f0-9]{32}", job_id or ""):
        abort(404)
    return JOB_DIR / f"{job_id}.json"


def write_job(job_id: str, payload: dict) -> None:
    ensure_runtime_dirs()
    JOB_DIR.mkdir(parents=True, exist_ok=True)
    path = job_path(job_id)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
    tmp.replace(path)


def read_job(job_id: str) -> dict:
    path = job_path(job_id)
    if not path.exists():
        abort(404)
    try:
        return json.loads(path.read_text(encoding="utf-8") or "{}")
    except Exception:
        return {"ok": False, "status": "failed", "message": "Não foi possível ler o status deste processamento."}


def run_online_download_job(job_id: str, form_data: dict) -> None:
    write_job(job_id, {"ok": True, "status": "running", "message": "Processando..."})
    try:
        with app.test_request_context("/api/online/download", method="POST", data=form_data):
            result = online_download()
        response, code = result if isinstance(result, tuple) else (result, 200)
        data = response.get_json(silent=True) or {}
        if code < 400 and data.get("ok"):
            data["status"] = "done"
            write_job(job_id, data)
        else:
            write_job(job_id, {"ok": False, "status": "failed", "message": data.get("message") or "Não foi possível concluir este download."})
    except Exception:
        write_job(job_id, {"ok": False, "status": "failed", "message": "Não foi possível concluir este download agora. Tente novamente em alguns minutos."})


