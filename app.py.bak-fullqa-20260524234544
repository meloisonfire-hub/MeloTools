@app.route("/api/documents/split-pdf", methods=["POST"])
def split_pdf():
    p, err = get_file("file", "pdf")
    if err:
        return fail(err)
    per_file = int(request.form.get("pages_per_file") or 1)
    if per_file < 1:
        return fail("Páginas por arquivo deve ser >= 1")

    reader = read_pdf(p)
    out_dir = TMP_DIR / f"split-{uuid.uuid4().hex[:10]}"
    out_dir.mkdir(parents=True, exist_ok=True)

    idx = 0
    part = 1
    while idx < len(reader.pages):
        writer = PdfWriter()
        for _ in range(per_file):
            if idx >= len(reader.pages):
                break
            writer.add_page(reader.pages[idx])
            idx += 1
        with (out_dir / f"part-{part}.pdf").open("wb") as f:
            writer.write(f)
        part += 1

    zip_path = RESULT_DIR / f"split-pdf-{uuid.uuid4().hex[:10]}.zip"
    shutil.make_archive(str(zip_path).replace(".zip", ""), "zip", out_dir)
    return ok_file(zip_path)


