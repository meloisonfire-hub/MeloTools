    payload["created_at"] = datetime.now().timestamp()
    tmp = format_cache_path(key).with_suffix(".tmp")
    tmp.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
    tmp.replace(format_cache_path(key))


