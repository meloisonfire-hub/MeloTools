    elif not quality:
        quality = "best"
    raw_bitrate = (request.form.get("bitrate") or "best").strip().lower()
    bitrate = re.sub(r"[^0-9]", "", raw_bitrate)
    if raw_bitrate in {"best", "source", "original"}:
        bitrate = raw_bitrate
    elif not bitrate:
        bitrate = "best"
    if not url:
        return fail("Informe a URL do vídeo.")
    cache_key = download_cache_key(url, mode, quality, bitrate)
    cached_path = read_download_cache(cache_key)
    if cached_path:
        return ok_file(cached_path)
    if url.startswith("mock://"):
        ext = "mp3" if mode == "audio" else "mp4"
        out = RESULT_DIR / f"download-mock-{uuid.uuid4().hex[:10]}.{ext}"
        out.write_bytes(b"mock")
        return ok_file(out)

    if is_threads_url(raw_url) or is_threads_url(url):
        try:
            return ok_file(download_threads_media(raw_url or url, mode, bitrate))
        except Exception as e:
            msg = str(e) or "N\u00e3o foi poss\u00edvel baixar este v\u00eddeo do Threads."
            if threads_oembed_recognizes(raw_url or url):
                return fail("Link do Threads reconhecido, mas " + msg)
            return fail("N\u00e3o foi poss\u00edvel reconhecer ou baixar este link do Threads agora. Verifique se o post \u00e9 p\u00fablico e se cont\u00e9m v\u00eddeo.")

    download_id = uuid.uuid4().hex[:8]
    outtmpl = str(RESULT_DIR / f"download-{download_id}.%(ext)s")
    ytdlp = ytdlp_cmd()
    cmd = [ytdlp] + ytdlp_speed_args() + ["--no-progress", "--no-warnings", "--no-playlist", "--retries", "5", "--fragment-retries", "5", "--socket-timeout", "30", "-o", outtmpl, url]
    if mode == "audio":
        if str(bitrate).isdigit():
            fmt = f"bestaudio[abr<={bitrate}][ext=m4a]/bestaudio[abr<={bitrate}]/bestaudio[ext=m4a]/bestaudio/best"
        else:
            fmt = "bestaudio[ext=m4a]/bestaudio/best"
        cmd = [ytdlp] + ytdlp_speed_args() + ["--no-progress", "--no-warnings", "--no-playlist", "--retries", "5", "--fragment-retries", "5", "--socket-timeout", "30", "-f", fmt, "-o", outtmpl, url]
    else:
        # Includes Threads and other social platforms handled by yt-dlp.
        # Prefer progressive/single-file first for speed and stability in browsers.
        if str(quality).isdigit():
            fmt = f"best[height<={quality}][ext=mp4]/best[height<={quality}]/best"
        else:
            fmt = "best[ext=mp4]/best"
        cmd = [ytdlp] + ytdlp_speed_args() + ["--no-progress", "--no-warnings", "--no-playlist", "--retries", "5", "--fragment-retries", "5", "--socket-timeout", "30", "-f", fmt, "-o", outtmpl, url]
    try:
        run_cmd(cmd)
    except Exception as e:
        # Retry matrix for unstable providers (especially YouTube watch/list/radio variants).
        host = urllib.parse.urlparse(url).netloc.lower()
        fallback_cmds = []
        if mode != "audio":
            fallback_cmds.extend([
                [ytdlp] + ytdlp_speed_args() + ["--no-progress", "--no-warnings", "--no-playlist", "--retries", "8", "--fragment-retries", "8", "--socket-timeout", "30", "-f", "best[ext=mp4]/best", "-o", outtmpl, url],
                [ytdlp] + ytdlp_speed_args() + ["--no-progress", "--no-warnings", "--no-playlist", "--retries", "8", "--fragment-retries", "8", "--socket-timeout", "30", "-f", "bestvideo+bestaudio/best", "-o", outtmpl, url],
            ])
            if "youtube.com" in host or "youtu.be" in host:
                fallback_cmds.extend([
                    [ytdlp] + ytdlp_speed_args() + ["--no-progress", "--no-warnings", "--no-playlist", "--extractor-args", "youtube:player_client=android", "--retries", "8", "--fragment-retries", "8", "--socket-timeout", "30", "-f", "bestvideo+bestaudio/best", "-o", outtmpl, url],
                    [ytdlp] + ytdlp_speed_args() + ["--no-progress", "--no-warnings", "--no-playlist", "--extractor-args", "youtube:player_client=web", "--retries", "8", "--fragment-retries", "8", "--socket-timeout", "30", "-f", "best", "-o", outtmpl, url],
                ])
        else:
            fallback_cmds.extend([
                [ytdlp] + ytdlp_speed_args() + ["--no-progress", "--no-warnings", "--no-playlist", "--retries", "8", "--fragment-retries", "8", "--socket-timeout", "30", "-f", "bestaudio[ext=m4a]/bestaudio/best", "-o", outtmpl, url],
            ])

        for fb in fallback_cmds:
            try:
                run_cmd(fb)
                break
            except Exception:
                continue
        else:
            msg = f"Falha ao baixar vídeo: {e}"
            lower = str(e).lower()
            if "youtube" in host or "youtu.be" in host:
                if "sign in" in lower or "bot" in lower or "forbidden" in lower or "429" in lower:
                    msg = "O YouTube bloqueou esta tentativa no momento. Tente novamente em alguns minutos ou com outra qualidade."
            if is_threads_url(raw_url) or is_threads_url(url):
                if threads_oembed_recognizes(raw_url):
                    msg = "Link do Threads reconhecido, mas este post não expôs um vídeo público para download. Verifique se o post contém vídeo e se está público."
                else:
                    msg = "Não foi possível reconhecer este link do Threads agora. Verifique se o post é público e tente novamente."
            return fail(msg)


    files = sorted(RESULT_DIR.glob(f"download-{download_id}.*"), key=lambda x: x.stat().st_mtime, reverse=True)
    files = [p for p in files if not p.name.endswith((".part", ".ytdl"))]
    if not files:
        return fail("Download finalizado, mas arquivo não foi localizado.")
    write_download_cache(cache_key, files[0])
    return ok_file(files[0])


