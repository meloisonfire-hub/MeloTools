@app.route("/api/online/instagram-tools", methods=["POST"])
def instagram_tools():
    url = (request.form.get("url") or "").strip()
    action = (request.form.get("action") or request.form.get("mode") or "video").strip().lower()
    if not url:
        return fail("Informe a URL do Instagram.")

    clean = url.split("?")[0].strip()

    action_map = {
        "video": "video",
        "videos": "videos",
        "transcript": "transcript",
        "transcricao": "transcript",
        "images": "images",
        "ocr": "ocr",
    }
    action = action_map.get(action, action)

    if action == "transcript":
        base = RESULT_DIR / f"instagram-transcript-{uuid.uuid4().hex[:10]}"
        outtmpl = str(base) + ".%(ext)s"
        cmd = [
            "yt-dlp",
            "--skip-download",
            "--write-auto-subs",
            "--sub-langs",
            "pt,en,pt-BR",
            "--sub-format",
            "vtt",
            "-o",
            outtmpl,
            clean,
        ]
        try:
            run_cmd(cmd)
        except Exception:
            return fail(
                "N\u00e3o foi poss\u00edvel gerar a transcrição deste link agora. "
                "Tente outro post/reel público do Instagram."
            )

        vtts = sorted(RESULT_DIR.glob(f"{base.name}*.vtt"), key=lambda x: x.stat().st_mtime, reverse=True)
        if not vtts:
            return fail("Este conteúdo n\u00e3o disponibilizou legendas para transcrição automática no momento.")

        raw = vtts[0].read_text(encoding="utf-8", errors="ignore")
        out_lines = []
        for ln in raw.splitlines():
            ln = ln.strip()
            if not ln:
                continue
            if ln.startswith("WEBVTT") or ln.startswith("NOTE") or ln.isdigit() or "-->" in ln:
                continue
            out_lines.append(ln)

        text = chr(10).join(out_lines).strip()
        if not text:
            return fail("N\u00e3o foi poss\u00edvel extrair texto da legenda deste conteúdo.")

        txt_out = RESULT_DIR / f"{base.name}.txt"
        txt_out.write_text(text, encoding="utf-8")
        return ok_file(txt_out)

    if action in {"video", "videos"}:
        outtmpl = str(RESULT_DIR / f"instagram-video-{uuid.uuid4().hex[:10]}.%(ext)s")
        cmd = ["yt-dlp", "--no-progress", "--no-warnings", "-f", "mp4/best", "-o", outtmpl, clean]
        try:
            run_cmd(cmd)
        except Exception as e:
            return fail(f"Falha ao processar v\u00eddeo do Instagram: {e}")
        files = sorted(RESULT_DIR.glob("instagram-video-*"), key=lambda x: x.stat().st_mtime, reverse=True)
        if not files:
            return fail("Processamento finalizado, mas arquivo n\u00e3o foi localizado.")
        return ok_file(files[0])

    if action == "images":
        return jsonify({
            "ok": True,
            "values": [
                f"Link validado: {clean}",
                "Extração de imagens será expandida em breve para todos os tipos de post.",
            ],
        })

    if action == "ocr":
        return jsonify({
            "ok": True,
            "values": [
                f"Link validado: {clean}",
                "OCR de imagens do Instagram está em evolução. Use OCR PDF/Imagem para arquivos locais.",
            ],
        })

    return jsonify({
        "ok": True,
        "values": [
            f"Link validado: {clean}",
            "Dica: use Converter link em QR Code para compartilhamento rápido.",
        ],
    })

