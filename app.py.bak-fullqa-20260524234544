@app.route("/api/calc/convert", methods=["POST"])
def calc_convert():
    ctype = (request.form.get("convert_type") or "temperature").strip()
    src = (request.form.get("from_unit") or "").strip().lower()
    dst = (request.form.get("to_unit") or "").strip().lower()
    n = float(request.form.get("number") or 0)

    if ctype == "temperature":
        if src == "c" and dst == "f":
            val = (n * 9 / 5) + 32
        elif src == "f" and dst == "c":
            val = (n - 32) * 5 / 9
        elif src == "c" and dst == "k":
            val = n + 273.15
        elif src == "k" and dst == "c":
            val = n - 273.15
        else:
            return fail("Conversão de temperatura não suportada.")
        return jsonify({"ok": True, "result": f"{n} {src.upper()} = {val:.4f} {dst.upper()}"})

    maps = {
        "weight": {"kg": 1, "g": 0.001, "lb": 0.45359237},
        "distance": {"m": 1, "km": 1000, "cm": 0.01, "mi": 1609.344},
        "filesize": {"b": 1, "kb": 1024, "mb": 1024**2, "gb": 1024**3, "tb": 1024**4},
    }
    if ctype not in maps:
        return fail("Tipo de conversão inválido.")
    table = maps[ctype]
    if src not in table or dst not in table:
        return fail("Unidade inválida para este tipo de conversão.")
    base = n * table[src]
    val = base / table[dst]
    return jsonify({"ok": True, "result": f"{n} {src} = {val:.6f} {dst}"})


