def read_download_cache(key: str, ttl_seconds: int = 21600):
    path = download_cache_path(key)
    if not path.exists():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8") or "{}")
        created = float(data.get("created_at") or 0)
        filename = str(data.get("filename") or "")
        target = RESULT_DIR / filename
        if created and (datetime.now().timestamp() - created) <= ttl_seconds and target.exists() and target.stat().st_size > 0:
            return target
    except Exception:
        return None
    return None


def write_download_cache(key: str, path: Path) -> None:
    if not path or not path.exists():
        return
    ensure_runtime_dirs()
    DOWNLOAD_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    payload = {"created_at": datetime.now().timestamp(), "filename": path.name}
    tmp = download_cache_path(key).with_suffix(".tmp")
    tmp.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
    tmp.replace(download_cache_path(key))


def parse_timer_seconds(raw: str) -> int:
    value = (raw or "").strip().lower()
    if not value:
        return 300
    # Supports plain seconds ("600") or compact duration ("10m", "2h", "90s").
    m = re.fullmatch(r"(\d{1,6})([smh]?)", value)
    if not m:
        return 300
    amount = int(m.group(1))
    unit = m.group(2) or "s"
    factor = {"s": 1, "m": 60, "h": 3600}.get(unit, 1)
    seconds = amount * factor
    return max(1, min(86400, seconds))



def ytdlp_cmd() -> str:
