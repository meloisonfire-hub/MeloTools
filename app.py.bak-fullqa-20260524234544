            "audio": [{"value": "320", "label": "320 kbps"}, {"value": "192", "label": "192 kbps"}],
            "source": "mock",
        })
    try:
        cache_key = format_cache_key(raw_url or url)
        cached = read_format_cache(cache_key)
        if cached:
            return jsonify({"ok": True, **cached})
        data = online_format_options(raw_url or url)
        write_format_cache(cache_key, data)
        return jsonify({"ok": True, **data})
    except Exception as e:
        return fail("N\u00e3o foi poss\u00edvel processar este link: " + str(e))




